# ─── External APIs ────────────────────────────────────────────────────────────
# Indian Kanoon — get a free key at https://indiankanoon.org/api/
INDIAN_KANOON_API_KEY=your_indian_kanoon_api_key_here

# Cohere — free tier works; get key at https://dashboard.cohere.com/
# Used for: outcome classification fallback + argument strength analysis
COHERE_API_KEY=your_cohere_api_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key (NOT anon key) — Settings → API → service_role
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT secret — Settings → API → JWT Secret
JWT_SECRET=your_jwt_secret_here

# ─── PostgreSQL (direct connection via Supabase) ──────────────────────────────
# Dashboard → Settings → Database → Connection parameters
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Built from the values above — replace <project-ref> and <password>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
ENVIRONMENT=development

# ─── Frontend (optional) ──────────────────────────────────────────────────────
# Override CORS allowed origin in production
# FRONTEND_ORIGIN=https://your-app.vercel.app
